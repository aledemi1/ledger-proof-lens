# Локальный сервер запускается и с пустым файлом: правила, SQLite, без почты.
# Скопируйте в .env и раскомментируйте только нужные строки. Значения ключей в git не коммитятся.

# --- Модель. Без ключа сверку считают правила. ---
# Любой OpenAI-совместимый API, например 4sapi:
# AI_BASE_URL=https://4sapi.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-5.6-sol

# Запасной вызов через Polza, если основной не ответил.
# Ключ: https://polza.ai/dashboard → баланс → раздел API Keys. Ключ начинается с pza_.
# Адрес и модель можно не задавать.
# POLZA_API_KEY=
# POLZA_AI_BASE_URL=https://polza.ai/api/v1
# POLZA_AI_MODEL=openai/gpt-5.6-sol

# Либо шлюз Lovable. Если задан, он становится основным вызовом.
# LOVABLE_API_KEY=
# LOVABLE_AI_BASE_URL=https://ai.gateway.lovable.dev/v1
# LOVABLE_AI_MODEL=google/gemini-2.5-flash

# Перед отправкой текст маскируют локальные pii-mask и Presidio
# (python scripts/privacy/setup.py). SVERKO_PRIVACY=off отключает маскировку.
# PDF распознаётся локально. Картинка страницы уходит в модель только после закраски персональных данных.
# SVERKO_PAGE_IMAGES=off оставляет модели один текст.
# SVERKO_PRIVACY=off
# SVERKO_PAGE_IMAGES=off

# Каталог оригиналов и локальной SQLite, если DATABASE_URL не задан.
# SVERKO_DATA_DIR=.data

# --- PostgreSQL. Без переменной сервер использует SQLite. ---
# sslmode=require шифрует соединение. Так подключается PostgreSQL Timeweb:
# его сертификат не входит в публичное хранилище.
# verify-full проверяет сертификат. Для частного центра укажите файл:
# PGSSLROOTCERT=/path/to/ca.pem
# DATABASE_URL=postgresql://user:password@host:5432/sverko?sslmode=require

# Первый администратор создаётся при старте, если такого адреса ещё нет.
# ADMIN_EMAIL=admin@sverko.ru
# ADMIN_PASSWORD=

# --- Почта. Без SMTP_HOST регистрация сразу открывает сессию. ---
# Хост Timeweb: smtp.timeweb.ru, порт 465, SSL.
# Логин — полный адрес ящика, и он же стоит в письме как отправитель.
# Входящие этого ящика читает администратор в разделе «Почта».
# IMAP по умолчанию — imap.timeweb.ru:993, логин и пароль те же, что у SMTP.
# APP_URL=https://sverko.ru
# SMTP_HOST=smtp.timeweb.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@sverko.ru
# SMTP_PASS=
# MAIL_FROM=Sverko <noreply@sverko.ru>
# IMAP_HOST=imap.timeweb.ru
# IMAP_PORT=993

# Сколько проверок и файлов читать одновременно.
# SVERKO_SESSION_CONCURRENCY=2
# SVERKO_READ_CONCURRENCY=3
