# Языковая модель необязательна. Без ключа однозначные пары сверяются правилами,
# а незнакомые подписи остаются на ручную проверку.
# Любой OpenAI-совместимый API, например 4sapi:
# AI_BASE_URL=https://4sapi.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-5.4

# Либо шлюз Lovable. Ключ только на сервере, не во фронтенде.
# LOVABLE_API_KEY=
# LOVABLE_AI_BASE_URL=https://ai.gateway.lovable.dev/v1
# LOVABLE_AI_MODEL=google/gemini-2.5-flash

# Каталог базы и оригиналов. По умолчанию .data в корне проекта.
# SVERKO_DATA_DIR=.data
